{
  "name": "ASPA Explorer",
  "short_name": "ASPA",
  "description": "Explore, check and follow the ASPA objects of the RPKI.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#2a78d6",
  "theme_color": "#2a78d6",
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
